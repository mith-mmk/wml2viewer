{
  "sourceLanguage" : "en",
  "strings" : {
    "Close" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "閉じる" } } } },
    "About" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "情報" } } } },
    "Appearance" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "外観" } } } },
    "Choose folder" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "フォルダを選択" } } } },
    "Navigate to the folder you want to browse, then tap Open." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "閲覧するフォルダへ移動し、「開く」をタップしてください。" } } } },
    "To continue from the selected file, keep its containing folder open and tap Open." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したファイルから続けて閲覧するには、そのファイルを含むフォルダを表示したまま「開く」をタップしてください。" } } } },
    "Done" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "完了" } } } },
    "Display" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "表示" } } } },
    "Files and restoration" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "Filesと復元" } } } },
    "Fit" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "表示方法" } } } },
    "Image" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "画像" } } } },
    "Keep screen awake" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "画面をスリープさせない" } } } },
    "Manage Files" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "ファイル管理" } } } },
    "Manga" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "マンガ" } } } },
    "Manga mode" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "マンガモード" } } } },
    "Page spacing" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "見開き間隔" } } } },
    "Open Files" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "ファイルを開く" } } } },
    "Retry" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "再試行" } } } },
    "The listed file is invalid" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "リストファイルが不正です" } } } },
    "A listed file entry is outside the selected folder" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "リスト項目が選択フォルダの外にあります" } } } },
    "No document" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "書類がありません" } } } },
    "No other supported files were found in the selected folder" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したフォルダに他の対応ファイルがありません" } } } },
    "No supported files were found in the selected folder" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したフォルダに対応ファイルがありません" } } } },
    "Open" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "開く" } } } },
    "Open a document from Files" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "Filesから書類を開きます" } } } },
    "Open a file or folder from Files" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "Filesからファイルまたはフォルダを開いてください" } } } },
    "Pages" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "ページ" } } } },
    "Remember last location" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "最後に開いた場所を記憶" } } } },
    "Restore last location" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "最後に開いた場所を復元" } } } },
    "Right to left" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "右から左へ読む" } } } },
    "Settings" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定" } } } },
    "Show top controls" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "上部コントロールを表示" } } } },
    "Theme" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "テーマ" } } } },
    "Thumbnail" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "サムネイル" } } } },
    "Unsupported document" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "対応していない書類です" } } } },
    "This animated image is not supported by the selected OS codec" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したOSコーデックではこのアニメーション画像に対応していません" } } } },
    "Unsupported file type. Choose an image, ZIP/LHA/LZH archive, or WMLTXT file." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "このファイル形式には対応していません。画像、ZIP/LHA/LZH書庫、またはWMLTXTファイルを選択してください。" } } } },
    "Unsupported file type “.%@”. Choose an image, ZIP/LHA/LZH archive, or WMLTXT file." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "ファイル形式「.%@」には対応していません。画像、ZIP/LHA/LZH書庫、またはWMLTXTファイルを選択してください。" } } } },
    "Could not display “%@”. The file may be damaged or use an unsupported variant." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」を表示できませんでした。ファイルが破損しているか、未対応の形式である可能性があります。" } } } },
    "Scanning folder…" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "フォルダを読み込み中…" } } } },
    "Opening file…" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "ファイルを読み込み中…" } } } },
    "Reading the folder contents. This may take a while for cloud or network folders." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "フォルダの内容を確認しています。クラウドやネットワーク上では時間がかかることがあります。" } } } },
    "Reading the selected file." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したファイルを読み込んでいます。" } } } },
    "Checking files: %lld of %lld" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "ファイルを確認中：%2$lld件中%1$lld件" } } } },
    "Folder selection was cancelled. The selected file remains open by itself." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "フォルダ選択をキャンセルしました。選択したファイルだけを表示します。" } } } },
    "Opening was cancelled." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み込みをキャンセルしました。" } } } },
    "Opening was cancelled. The current document remains open." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み込みをキャンセルしました。現在の書類はそのまま表示します。" } } } },
    "Files closed before a selection was made." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "Filesが選択前に終了しました。もう一度ファイルを選択してください。" } } } },
    "Files closed unexpectedly. The current document remains open." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "Filesが予期せず終了しました。現在の書類はそのまま表示します。" } } } },
    "The document is no longer available" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "書類を利用できなくなりました" } } } },
    "Select the containing folder for this listed file" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "この一覧ファイルを含むフォルダを選択してください" } } } },
    "The selected folder does not contain the opened file" : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したフォルダに開いたファイルがありません" } } } },
    "This file provider is offline. Check the connection and try again." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "ファイル提供元がオフラインです。接続を確認して再試行してください。" } } } },
    "Sign in to this file provider, then try again." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "ファイル提供元にサインインしてから再試行してください。" } } } },
    "This file provider is temporarily unavailable. Try again or choose another source." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "ファイル提供元を一時的に利用できません。再試行するか、別の場所を選択してください。" } } } },

    "This clears app bookmarks, not Apple Files Recents." : { "localizations" : { "ja" : { "stringUnit" : { "state" : "translated", "value" : "アプリのbookmarkだけを消去し、Apple Filesの「最近使った項目」は消去しません。" } } } },
